---
import { getCollection, type CollectionEntry } from 'astro:content';
import getReadingTime from 'reading-time';
import Content from '../../components/Content.astro';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
    const posts = await getCollection('bits');
    return posts.map((post: any) => ({
        params: { slug: post.slug },
        props: { post },
    }));
}

type Props = {post: CollectionEntry<'bits'>};
const {post} = Astro.props;
const { Content: RenderedContent } = await post.render();
const readingTime = getReadingTime(post.body).minutes.toFixed(0);

// Use excerpt or generate description
const description = post.data.excerpt || `${post.data.title}. Insights and experiences from backend engineering and DevOps practices by Akbar Ramadhan.`;
---

<Layout 
    title={`${post.data.title} | Blog`}
    description={description}
    type="article"
    publishedTime={post.data.date}
    tags={post.data.tags}
>
    <Content 
        title={post.data.title} 
        date={new Date(post.data.date)} 
        tags={post.data.tags} 
        readingTime={readingTime} 
        type="bits" 
        proseSize="lg">
            <RenderedContent />
    </Content>
</Layout>