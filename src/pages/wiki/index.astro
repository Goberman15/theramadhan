---
import { getCollection } from 'astro:content';
import Tag from '../../components/Tag.astro';
import Wiki from '../../layouts/Wiki.astro';

// Get all wiki posts and extract unique tags
const wikis = await getCollection('wiki');
const allTags = new Set<string>();

wikis.forEach((wiki: any) => {
    if (wiki.data.tags) {
        wiki.data.tags.forEach((tag: string) => allTags.add(tag));
    }
});

// Sort tags alphabetically for consistent display
const sortedTags = Array.from(allTags).sort();

// Get recent articles (latest 6)
const recentWikis = wikis
    .sort((a: any, b: any) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())
    .slice(0, 6);
---

<Wiki title="Wiki">
    <div class="flex flex-col">
        <h1 class="text-4xl text-center font-bold mb-8">Wiki</h1>
        <p class="text-center">This is a collection of my notes and thoughts.</p>
        <p class="text-center">I add this part of my site to document what I learn.</p>
        <p class="text-center mb-6">I always tried to add only things that I already understand.</p>
    </div>
    <section class="mb-12">
        <h2 class="text-2xl text-center font-bold mb-6">Browse by Topics</h2>
        <div class="flex flex-wrap gap-3 justify-center max-w-4xl mx-auto">
            {sortedTags.map((tag) => (
                <Tag tag={tag} href={`/wiki/tags/${tag}`} />
            ))}
        </div>
        <p class="text-center text-gray-400 text-sm mt-4">
            {sortedTags.length} topics • {wikis.length} articles
        </p>
    </section>

    <section class="mb-8">
        <h2 class="text-2xl text-center font-bold mb-8">Recent Articles</h2>
        <div class="grid gap-4 md:gap-6 max-w-4xl mx-auto">
            {recentWikis.map((wiki: any) => (
                <article class="bg-gray-900/30 border border-gray-800 rounded-lg p-6 hover:border-blue-500/30 hover:bg-gray-900/50 transition-all duration-200">
                    <h3 class="text-xl font-semibold mb-3">
                        <a href={`/wiki/${wiki.slug}`} 
                           class="text-gray-50 hover:text-blue-400 transition-colors duration-200">
                            {wiki.data.title}
                        </a>
                    </h3>
                    <div class="flex items-center justify-between text-gray-500 text-sm mb-3">
                        <time>{new Date(wiki.data.date).toLocaleDateString()}</time>
                        {wiki.data.tags && wiki.data.tags.length > 0 && (
                            <div class="flex gap-2">
                                {wiki.data.tags.slice(0, 3).map((tag: string) => (
                                    <a href={`/wiki/tags/${tag}`} 
                                       class="text-xs text-gray-500 hover:text-blue-400 transition-colors">
                                        #{tag}
                                    </a>
                                ))}
                            </div>
                        )}
                    </div>
                    {wiki.data.description && (
                        <p class="text-gray-300 text-sm leading-relaxed">
                            {wiki.data.description}
                        </p>
                    )}
                </article>
            ))}
        </div>
    </section>
</Wiki>
