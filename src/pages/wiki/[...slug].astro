---
import { getCollection, type CollectionEntry } from 'astro:content';
import Content from '../../components/Content.astro';
import Wiki from '../../layouts/Wiki.astro';

export async function getStaticPaths() {
    const wikis = await getCollection('wiki');
    return wikis.map((wiki: any) => ({
        params: { slug: wiki.slug },
        props: { wiki },
    }));
}

type Props = {wiki: CollectionEntry<'wiki'>};
const {wiki} = Astro.props;
const { Content: RenderedContent } = await wiki.render();

const description = `Technical notes and learnings about ${wiki.data.title}. Part of Akbar Ramadhan's knowledge base on backend engineering and DevOps practices.`;
---

<Wiki 
    title={`${wiki.data.title} | Wiki`}
    description={description}
    publishedTime={wiki.data.date.toISOString()}
    tags={wiki.data.tags}
    currentSlug={wiki.slug}
>
    <Content 
        title={wiki.data.title} 
        date={new Date(wiki.data.date)} 
        tags={wiki.data.tags} 
        type="wiki" 
        proseSize="sm">
            <RenderedContent />
    </Content>
</Wiki>