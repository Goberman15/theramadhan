---
import Header from '../components/Header.astro';
import Analytics from '../components/Analytics.astro';
import { ViewTransitions } from 'astro:transitions';

interface Props {
	title: string;
	description?: string;
	image?: string;
	type?: 'website' | 'article';
	publishedTime?: string;
	modifiedTime?: string;
	tags?: string[];
}

const { 
	title, 
	description = "Backend Engineer & DevOps enthusiast sharing knowledge about scalable systems, cloud infrastructure, and automation practices",
	image = "/favicon.svg",
	type = "website",
	publishedTime,
	modifiedTime,
	tags = []
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const socialImage = new URL(image, Astro.site);
---

<!doctype html>
<html lang="en" prefix="og: https://ogp.me/ns#">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="generator" content={Astro.generator} />
		
		<!-- Primary Meta Tags -->
		<title>{title}</title>
		<meta name="title" content={title} />
		<meta name="description" content={description} />
		<meta name="author" content="Akbar Ramadhan" />
		<link rel="canonical" href={canonicalURL} />
		
		<!-- Open Graph / Facebook -->
		<meta property="og:type" content={type} />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={socialImage} />
		<meta property="og:site_name" content="Akbar Ramadhan - Backend Engineer" />
		<meta property="og:locale" content="en_US" />
		{publishedTime && <meta property="article:published_time" content={publishedTime} />}
		{modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
		{tags.map(tag => <meta property="article:tag" content={tag} />)}
		
		<!-- Twitter -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:url" content={canonicalURL} />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={socialImage} />
		<meta name="twitter:creator" content="@akbarramadhan" />
		
		<!-- Favicon -->
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="apple-touch-icon" href="/favicon.svg" />
		
		<!-- PWA -->
		<link rel="manifest" href="/manifest.json" />
		<meta name="theme-color" content="#0f172a" />
		<meta name="apple-mobile-web-app-capable" content="yes" />
		<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
		<meta name="mobile-web-app-capable" content="yes" />
		
		<!-- Fonts -->
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Atkinson+Hyperlegible:wght@400;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet" />
		
		<!-- Structured Data -->
		<script type="application/ld+json">
		{
			"@context": "https://schema.org",
			"@type": "Person",
			"name": "Akbar Ramadhan",
			"url": "https://theramadhan.dev",
			"jobTitle": "Backend Engineer",
			"description": "Backend Engineer & DevOps enthusiast sharing knowledge about scalable systems",
			"sameAs": [
				"https://github.com/goberman15",
				"https://linkedin.com/in/akbarramadhan"
			],
			"knowsAbout": [
				"Backend Development",
				"DevOps",
				"Cloud Infrastructure",
				"System Architecture",
				"Automation"
			]
		}
		</script>
		
        <ViewTransitions />
        
        <!-- Service Worker Registration -->
        <script is:inline>
          if ('serviceWorker' in navigator) {
            window.addEventListener('load', () => {
              navigator.serviceWorker.register('/sw.js')
                .then((registration) => {
                  console.log('SW registered: ', registration);
                })
                .catch((registrationError) => {
                  console.log('SW registration failed: ', registrationError);
                });
            });
          }
        </script>
	</head>
	<body class="bg-gray-950 text-gray-50 font-atkinson antialiased">
        <div class="flex flex-col min-h-screen">
            <Header />
            <slot />
        </div>
        
        <!-- Analytics (privacy-focused) -->
        <Analytics enableAnalytics={import.meta.env.PROD} />
	</body>
</html>

<style is:global>
	body {
		font-family: 'Atkinson Hyperlegible', sans-serif;
		line-height: 1.7;
		font-size: 16px;
		-webkit-font-smoothing: antialiased;
		-moz-osx-font-smoothing: grayscale;
	}
	
	/* Smooth scrolling */
	html {
		scroll-behavior: smooth;
	}
	
	/* Enhanced scrollbar styling */
	::-webkit-scrollbar {
		width: 6px;
	}
	::-webkit-scrollbar-track {
		background: #0f172a;
	}
	::-webkit-scrollbar-thumb {
		background: #475569;
		border-radius: 3px;
	}
	::-webkit-scrollbar-thumb:hover {
		background: #64748b;
	}
	
	/* Enhanced focus styles for better accessibility */
	*:focus-visible {
		outline: 2px solid #60a5fa;
		outline-offset: 2px;
		border-radius: 2px;
	}
	
	/* Better selection colors */
	::selection {
		background-color: #60a5fa;
		color: #0f172a;
	}
	
	::-moz-selection {
		background-color: #60a5fa;
		color: #0f172a;
	}
	
	/* Reduce motion for accessibility */
	@media (prefers-reduced-motion: reduce) {
		*, *::before, *::after {
			animation-duration: 0.01ms !important;
			animation-iteration-count: 1 !important;
			transition-duration: 0.01ms !important;
		}
	}
</style>