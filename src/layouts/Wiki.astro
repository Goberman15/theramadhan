---
import WikiContent from "../components/WikiContent.astro";
import WikiSidebar from "../components/WikiSidebar.astro";
import Layout from "./Layout.astro";

interface Props {
    title: string;
    description?: string;
    publishedTime?: string;
    modifiedTime?: string;
    tags?: string[];
    currentSlug?: string;
}

const { title, description, publishedTime, modifiedTime, tags, currentSlug }: Props = Astro.props;
---

<Layout 
    title={title}
    description={description}
    type="article"
    publishedTime={publishedTime}
    modifiedTime={modifiedTime}
    tags={tags}
>
    <div class="flex">
        <WikiSidebar currentSlug={currentSlug} />
        <WikiContent>
            <slot />
        </WikiContent>
    </div>
</Layout>