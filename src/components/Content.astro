---
import FormattedDate from './FormattedDate.astro';
import Tag from './Tag.astro';  

interface Props {
    title: string;
    date: Date;
    tags: string[];
    readingTime?: string;
    type: 'bits' | 'wiki';
    proseSize: 'lg' | 'md' | 'sm';
}

const { title, date, tags, readingTime, type, proseSize } = Astro.props as Props;
---

<div class="mx-auto px-6 py-16 w-full max-w-4xl font-atkinson">
    <!-- Enhanced Header Section -->
    <header class="mb-16 text-center">
        <h1 class="text-4xl font-bold text-gray-50 mb-6 leading-tight">
            {title}
        </h1>
        
        <div class="flex items-center justify-center text-sm text-gray-500 mb-6 space-x-4">
            <FormattedDate date={date} />
            {readingTime && (
                <>
                    <span class="w-1 h-1 bg-gray-600 rounded-full"></span>
                    <span>{readingTime} min read</span>
                </>
            )}
        </div>
        
        {tags.length > 0 && (
            <div class="flex flex-wrap gap-2 justify-center">
                {tags.map((tag: string) => (
                    <Tag tag={tag} href={`/${type}/tags/${tag}`} />
                ))}
            </div>
        )}
    </header>

    <!-- Enhanced Content Section with Optimal Readability -->
    <article class="prose prose-invert prose-lg max-w-none">
        <slot />
    </article>
</div>
